  "vetoes": [
    {
      "id": "V01",
      "text": "未经15—20秒真实动态样片批准即开始批量生图、批量Flow、全片动画或正式合成；",
      "source_line": 365,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_production_enforcement.py"
      ]
    },
    {
      "id": "V02",
      "text": "未完成人话版导演理解、完整故事板和全片有声动态分镜，或任一项未获用户批准即批量生产；",
      "source_line": 366,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_production_enforcement.py"
      ]
    },
    {
      "id": "V03",
      "text": "预设固定章节/镜头数量、为凑数碎切，或故事板没有覆盖完整母钟；",
      "source_line": 367,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_production_enforcement.py"
      ]
    },
    {
      "id": "V04",
      "text": "可理解画面段没有明确表现路线、观众结论、动画动作、阅读停留和前后接力；",
      "source_line": 368,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V05",
      "text": "准确学校名、数字、表格、名单或政策正文交给图生视频直接生成；",
      "source_line": 369,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V06",
      "text": "官方材料没有原始来源，或自制图表没有可读来源脚注与项目证据；",
      "source_line": 370,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V07",
      "text": "官方材料直接全屏硬贴浏览器/PDF/UI，没有经过`design.md`统一证据载体和转场；",
      "source_line": 371,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V08",
      "text": "空纸、纯色或无语义背景只剩唯一大字和字幕，形成普通PPT页或连续轮播；",
      "source_line": 372,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V09",
      "text": "图生视频预计时长短于对应口播却没有续接方案，或使用明显慢放、尾帧停死、无意义循环和静态闪图补时长；",
      "source_line": 373,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_dynamic_asset_duration.py"
      ]
    },
    {
      "id": "V10",
      "text": "单条图生视频连续使用超过10.0秒且没有用户针对该镜头的明确例外批准；",
      "source_line": 374,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_dynamic_asset_duration.py"
      ]
    },
    {
      "id": "V11",
      "text": "项目缺少已批准并通过哈希校验的`design.md`，或生图/图生视频没有引用锁定风格板；",
      "source_line": 375,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_production_enforcement.py"
      ]
    },
    {
      "id": "V12",
      "text": "只给图生视频供应商纯文字，让它从空白重新决定人物、场景和画风；",
      "source_line": 376,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V13",
      "text": "未经完整低清粗剪批准即渲染正式母版；",
      "source_line": 377,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "scripts/production_runner.py",
        "vendor/editorial-magazine-explainer-producer/scripts/validate_production_enforcement.py"
      ]
    },
    {
      "id": "V14",
      "text": "画面像PPT、像廉价AI、画风混乱或动画僵硬，却用机器QA合格继续推进；",
      "source_line": 378,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V15",
      "text": "人物、视频或浅色纸张上出现无稳定实体底的裸白解释字；",
      "source_line": 379,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V16",
      "text": "组件文字使用全片绝对坐标假装嵌入，或卡片缩小后核心字低于手机舒适阅读；",
      "source_line": 380,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V17",
      "text": "品牌slogan与普通字幕同时重复显示；",
      "source_line": 381,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V18",
      "text": "用整图轻动冒充语义动画；",
      "source_line": 382,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V19",
      "text": "主构图闪切到观众无法看清，或短阶段无例外记录；",
      "source_line": 383,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V20",
      "text": "空白气泡、票据、输入框、选择卡等语义容器；",
      "source_line": 384,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
      "id": "V21",
      "text": "解释文字复述字幕、不可读小字、全片同一种卡片；",
      "source_line": 385,
      "enforcement": "真实媒体/结构校验加对应视听或语义审核；不能用布尔值替代实际证据",
      "references": [
        "skills/magazine-production/references/quality-contract.md",
        "vendor/editorial-magazine-explainer-producer/references/revision-qa-and-closure.md"
      ]
    },
    {
